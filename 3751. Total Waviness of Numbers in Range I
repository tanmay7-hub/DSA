class Solution {
public:
    int totalWaviness(int num1, int num2) {
        int count=0;
        for(int i=num1;i<=num2;i++){         
            string s=to_string(i);
            if(s.size()<3)continue;
            for(int i=1;i<s.size()-1;i++){
                int fr=s[i-1];
                int md=s[i];
                int ls=s[i+1];
                if((md<fr&&md<ls)||(md>fr&&md>ls)){
                    count++;
                }
            }
        }
        return count;
    }
};
