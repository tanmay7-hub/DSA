   // bit approach
    vector<int> findThePrefixCommonArray(vector<int>& A, vector<int>& B) {
       int n = A.size();
       vector<int>ans(n);
       bitset<51>seen;
       int count = 0 ;
       for( int i = 0 ; i < n ; i++ ){
            count += seen[A[i]];
            seen.set(A[i]);

            count += seen[B[i]];
            seen.set(B[i]);

            ans[i] = count;
       }

        
        return ans;




 // normal approach
    vector<int> findThePrefixCommonArray(vector<int>& A, vector<int>& B) {
       int n = A.size();
       vector<int>ans;
       vector<int>freq(51,0);

       for( int i = 0 ; i < n ; i++ ){
            if(i == 0 ){

                freq[A[i]]++;
                freq[B[i]]++;
            
                int curr = (freq[A[i]] == 2);
                ans.push_back(curr);
            }else{
                int curr = 0;
                if(A[i] != B[i]){
                    freq[A[i]]++;
                    freq[B[i]]++;
                   curr = (freq[A[i]] == 2) + (freq[B[i]] == 2);
                }else{
                    freq[A[i]] = 2;
                    curr = 1;
                }
                ans.push_back(curr + ans[i-1]);
            }
       }
        
        return ans;
    }
